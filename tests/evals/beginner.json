{
  "_about": "Beginner question set for Ask (audience 3: people who know nothing about security). Graded in code by scripts/eval-ask.mjs, never by a model. Questions are written for this repo, modelled on the hub's what-now topics and public FTC/NCSC scam scenarios. mustHub: hub ids the answer must link (from data/hub-features.json); mayHub: ids that are fine but not required. mustInclude: groups; a group passes when any one of its alternatives appears, and an alternative with ' + ' needs all its parts (case-insensitive substrings). mustNotInclude: phrases that fail the answer. maxWords: word cap. mustCallTool: tools that must appear in the trace. mustDecline: the answer must refuse. Every answer is also checked for raw or defanged URLs. tests/eval-grade.test.mjs checks this file's shape.",
  "set": "beginner",
  "defaults": {
    "maxWords": 220,
    "mustNotInclude": ["you're safe", "you are safe", "nothing to worry about", "it's fine", "no need to worry", "don't worry"]
  },
  "questions": [
    {
      "id": "q01",
      "topic": "clicked a link",
      "question": "I clicked a link in a text that said my package couldn't be delivered. I didn't type anything. Am I hacked?",
      "mustHub": ["what-now"],
      "mayHub": ["link", "lookup"],
      "mustInclude": [["didn't type", "did not type", "didn't enter", "did not enter", "only clicked", "just clicking", "just opening", "only opening"], ["delete", "block", "report", "ignore"]]
    },
    {
      "id": "q02",
      "topic": "typed a password",
      "question": "I typed my bank password into a page from a text message link. What do I do?",
      "mustHub": ["what-now"],
